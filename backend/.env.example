PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:3000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/mandi-fresh for a local MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mandi-fresh?retryWrites=true&w=majority
# Uncomment if you get "querySrv ECONNREFUSED" when connecting to Atlas
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Email (used to answer contact messages from the admin panel). Brevo example:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
# Must be a sender address you have verified with your email provider
SENDER_EMAIL=you@example.com
SENDER_NAME=Mandi Fresh
